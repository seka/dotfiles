#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required. Run scripts/macos/setup-brew to install the Brewfile packages first." >&2
  exit 1
fi

# Python本体をuvで管理するため、安定版を導入しpython・python3の実行リンクも作成する。
# 既存のリンクが別ツールの管理下なら上書きせず、uvのエラーで停止する。
uv python install --default
export PATH="$HOME/.local/bin:$PATH"

# 各ツールの実行環境を独立して管理するため、専用の仮想環境にuv管理のPythonで導入する。
# 既存のuv管理ツールは再利用し、他の管理元の実行ファイルは強制上書きしない。
for tool in pynvim codespell ruff; do
  uv tool install --managed-python "$tool"
done
