#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

if ! command -v gh >/dev/null 2>&1; then
  echo "gh not found. Skipping AI agent skill installation."
  exit 0
fi

AGENTS=(
  "github-copilot"
  "claude-code"
  "codex"
  "gemini-cli"
)

echo "Installing GitHub skills..."
while IFS=$'\t' read -r repository skill; do
  for agent in "${AGENTS[@]}"; do
    gh skill install "$repository" "$skill" --agent "$agent" --scope user --force
  done
done < "$(dirname "$0")/../resources/agent-skills.tsv"
echo "GitHub skills installed."

echo "Installing official agent-browser skill..."
npx --yes skills add vercel-labs/agent-browser --skill agent-browser --global --agent "${AGENTS[@]}" --yes
echo "agent-browser skill installed."

echo "Installing Anatomy skill..."
npx --yes skills add wheresryan22/anatomy --global --agent "${AGENTS[@]}" --yes
echo "Anatomy skill installed."

bash "$(dirname "$0")/distribute-skills" --source "$HOME/.agents/skills" --target antigravity

echo "Installing crit plugins..."
if command -v crit >/dev/null 2>&1; then
  (
    cd ~
    crit install github-copilot
  ) || echo "crit github-copilot install skipped or failed."

  (
    cd ~
    crit install gemini
  ) || echo "crit gemini install skipped or failed."

  (
    cd ~
    crit install codex-plugin
  ) || echo "crit codex-plugin install skipped or failed."
fi

if command -v claude >/dev/null 2>&1; then
  claude plugin marketplace add tomasz-tomczyk/crit || echo "claude crit marketplace already exists or failed."
  claude plugin install crit@crit || echo "claude crit plugin already installed or failed."
fi
echo "crit plugins installed."
