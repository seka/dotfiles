#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

DOTFILES_ROOT="${DOTFILES_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
DOTFILES_OS="${DOTFILES_OS:-macos}"

copy_or_link_file() {
  local source="$1"
  local target="$2"

  mkdir -p "$(dirname "$target")"

  if [[ "$DOTFILES_OS" == "windows" ]]; then
    cp -f "$source" "$target"
  else
    ln -sf "$source" "$target"
  fi
}

render_template() {
  local template="$1"
  local target="$2"
  local os="$3"
  local home_path="$HOME"
  local local_appdata="${LOCALAPPDATA:-}"
  local codex_resources="/Applications/Codex.app/Contents/Resources"
  local codex_cli="$codex_resources/codex"

  if [[ "$os" == windows ]]; then
    if [[ -z "$local_appdata" ]]; then
      echo "LOCALAPPDATA is required to render Windows Codex paths." >&2
      return 1
    fi
    if command -v cygpath >/dev/null 2>&1; then
      home_path="$(cygpath -m "$home_path")"
      local_appdata="$(cygpath -m "$local_appdata")"
    fi
  elif [[ "$os" == macos ]]; then
    if [[ ! -x "$codex_resources/cua_node/bin/node_repl" && -x /Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node_repl ]]; then
      codex_resources="/Applications/ChatGPT.app/Contents/Resources"
    fi
    codex_cli="$codex_resources/codex"
    if [[ -x "$codex_resources/codex-cli/CodexCLI.app/Contents/MacOS/codex" ]]; then
      codex_cli="$codex_resources/codex-cli/CodexCLI.app/Contents/MacOS/codex"
    fi
  fi

  mkdir -p "$(dirname "$target")"

  # 環境変数はawkの-vによるバックスラッシュ解釈を避けて渡し、挿入時にTOML文字列としてエスケープする。
  DOTFILES_TEMPLATE_HOME="$home_path" DOTFILES_TEMPLATE_LOCALAPPDATA="$local_appdata" \
    DOTFILES_TEMPLATE_CODEX_RESOURCES="$codex_resources" DOTFILES_TEMPLATE_CODEX_CLI="$codex_cli" \
    awk -v os="$os" '
    function toml_escape(value, result, i, c) {
      result = ""
      for (i = 1; i <= length(value); i++) {
        c = substr(value, i, 1)
        if (c == "\\") result = result "\\\\"
        else if (c == "\"") result = result "\\\""
        else if (c == "\n") result = result "\\n"
        else if (c == "\r") result = result "\\r"
        else if (c == "\t") result = result "\\t"
        else result = result c
      }
      return result
    }
    # gsubの置換規則で & やバックスラッシュを壊さず、挿入値を再展開しないよう元の文字列だけを走査する。
    function replace_literal(text, token, value, result, pos) {
      result = ""
      while ((pos = index(text, token)) != 0) {
        result = result substr(text, 1, pos - 1) value
        text = substr(text, pos + length(token))
      }
      return result text
    }
    /^# @if / {
      active = ($3 == os)
      next
    }
    /^# @endif/ {
      active = 1
      next
    }
    active != 0 {
      line = replace_literal($0, "{{HOME}}", toml_escape(ENVIRON["DOTFILES_TEMPLATE_HOME"]))
      line = replace_literal(line, "{{LOCALAPPDATA}}", toml_escape(ENVIRON["DOTFILES_TEMPLATE_LOCALAPPDATA"]))
      line = replace_literal(line, "{{CODEX_APP_RESOURCES}}", toml_escape(ENVIRON["DOTFILES_TEMPLATE_CODEX_RESOURCES"]))
      print replace_literal(line, "{{CODEX_CLI_PATH}}", toml_escape(ENVIRON["DOTFILES_TEMPLATE_CODEX_CLI"]))
    }
  ' "$template" > "$target"
}

echo "==> Installing Claude settings"
mkdir -p "$HOME/.claude"
copy_or_link_file "$DOTFILES_ROOT/ai-agents/AGENTS.md" "$HOME/.claude/CLAUDE.md"
copy_or_link_file "$DOTFILES_ROOT/ai-agents/claude/settings.json" "$HOME/.claude/settings.json"

mkdir -p "$HOME/.claude/commands"
for F in "$DOTFILES_ROOT"/ai-agents/skills/*.md; do
  copy_or_link_file "$F" "$HOME/.claude/commands/$(basename "$F")"
done
echo "--> Claude settings installed"

echo "==> Installing Gemini settings"
mkdir -p "$HOME/.gemini"
copy_or_link_file "$DOTFILES_ROOT/ai-agents/AGENTS.md" "$HOME/.gemini/AGENTS.md"
copy_or_link_file "$DOTFILES_ROOT/ai-agents/gemini/settings.json" "$HOME/.gemini/settings.json"
echo "--> Gemini settings installed"

if [[ ! -e "$HOME/.gemini/GEMINI.md" && ! -L "$HOME/.gemini/GEMINI.md" ]]; then
  copy_or_link_file "$DOTFILES_ROOT/ai-agents/AGENTS.md" "$HOME/.gemini/GEMINI.md"
else
  echo "Existing ~/.gemini/GEMINI.md preserved; review Web search instructions there manually."
fi

echo "==> Installing Codex settings"
mkdir -p "$HOME/.codex"
copy_or_link_file "$DOTFILES_ROOT/ai-agents/AGENTS.md" "$HOME/.codex/AGENTS.md"
render_template "$DOTFILES_ROOT/ai-agents/codex/config.toml.template" "$HOME/.codex/config.toml" "$DOTFILES_OS"

echo "--> Codex settings installed"

if [[ "$DOTFILES_OS" == "windows" ]]; then
  bash "$DOTFILES_ROOT/scripts/common/distribute-skills" --copy
else
  bash "$DOTFILES_ROOT/scripts/common/distribute-skills"
fi
