# Extra many types of compressed packages
# Credit: http://nparikh.org/notes/zshrc.txt
extract() {
    if [ -f "$1" ]; then
    case "$1" in
        *.tar.bz2)  tar -jxvf "$1"                        ;;
        *.tar.gz)   tar -zxvf "$1"                        ;;
        *.bz2)      bunzip2 "$1"                          ;;
        *.dmg)      hdiutil mount "$1"                    ;;
        *.gz)       gunzip "$1"                           ;;
        *.tar)      tar -xvf "$1"                         ;;
        *.tbz2)     tar -jxvf "$1"                        ;;
        *.tgz)      tar -zxvf "$1"                        ;;
        *.zip)      unzip "$1"                            ;;
        *.ZIP)      unzip "$1"                            ;;
        *.pax)      cat "$1" | pax -r                     ;;
        *.pax.Z)    uncompress "$1" --stdout | pax -r     ;;
        *.Z)        uncompress "$1"                       ;;
        *) echo "'$1' cannot be extracted/mounted via extract()" ;;
    esac
    else
        echo "'$1' is not a valid file to extract"
    fi
}

zle-line-init() {
    printf "%s" "${terminfo[smkx]}"
}

zle-line-finish() {
    printf "%s" "${terminfo[rmkx]}"
}

# alias ps aux | grep hoge
# http://qiita.com/takc923/items/fb0e35165affb03356a7
psgrep() {
    local PSRESULT="$(ps aux)"
    echo $PSRESULT | head -1
    echo $PSRESULT | tail -n +2 | grep $*
}

# Get the value of an alias.
alias-value() {
    alias "$1" | sed "s/^$1='\(.*\)'$/\1/"
    test $(alias "$1")
}

# ------------------------------
# Git
# ------------------------------
git-delete-merged-branches-and-worktrees() {
    emulate -L zsh
    (( $# == 0 )) || return 2

    local active_worktree head default_branch records refs
    active_worktree=$(git rev-parse --show-toplevel) || return 1
    head=$(git rev-parse --verify HEAD) || return 1
    default_branch=$(git config --get git-extras.default-branch)
    if [[ -z "$default_branch" ]]; then
        default_branch=$(git config --get init.defaultBranch)
    fi
    default_branch=${default_branch:-main}

    # ローカルブランチ単体と worktree の両方で、基幹ブランチを保護する。
    local protected_branches='(main|master|develop|release|release/*|release-*|release_*)'
    local -a branches branch_tips worktree_checks merged_names
    local -A worktree_paths worktree_tips
    local field branch worktree tip changes
    local is_main=1 unavailable=0
    records=$(git worktree list --porcelain -z) || return 1
    while IFS= read -r -d '' field; do
        case "$field" in
            'worktree '*) worktree=${field#worktree } ;;
            'HEAD '*) tip=${field#HEAD } ;;
            'branch refs/heads/'*) branch=${field#branch refs/heads/} ;;
            locked*|prunable*) unavailable=1 ;;
            '')
                if (( !is_main && !unavailable )) &&
                   [[ -n "$branch" && "$branch" != ${~protected_branches} &&
                      "$branch" != "$default_branch" && -d "$worktree" &&
                      "${worktree:A}" != "${active_worktree:A}" ]]; then
                    changes=$(git --no-optional-locks -C "$worktree" status --porcelain --untracked-files=normal) || return 1
                    if [[ -z "$changes" ]]; then
                        worktree_checks+=("$branch" "$tip")
                        worktree_paths[$branch]=$worktree
                        worktree_tips[$branch]=$tip
                    fi
                fi
                is_main=0 unavailable=0
                branch= worktree= tip=
                ;;
        esac
    done <<< "$records"

    if (( ${#worktree_checks} )); then
        # Bash は git-gtr の PR/MR 判定にだけ使う。clean の prune や空ディレクトリ削除は呼ばない。
        local merged
        merged=$(bash -c '
            set -e
            gtr_dir=${GTR_DIR:-/opt/homebrew/opt/git-gtr}
            for library in ui config provider; do
                source "$gtr_dir/lib/$library.sh"
            done
            provider=$(detect_provider) || {
                printf "%s\n" "GitHub/GitLab を判定できませんでした。" >&2
                exit 1
            }
            ensure_provider_cli "$provider"
            while (( $# )); do
                if check_branch_merged "$provider" "$1" "" "$2"; then
                    printf "%s\n" "$1"
                fi
                shift 2
            done
        ' git-gtr-merged "${worktree_checks[@]}") || return 1
        if [[ -n "$merged" ]]; then
            merged_names=("${(@f)merged}")
        fi
    fi

    # git-extras と同様、現在の HEAD にマージ済みのブランチから、
    # checkout 中のブランチと既定ブランチ名・svn を含む名前を除く。
    refs=$(git for-each-ref --merged="$head" \
        --format='%(if)%(worktreepath)%(then)checked-out%(else)%(objectname) %(refname:lstrip=2)%(end)' refs/heads/) || return 1
    while read -r tip branch; do
        [[ -n "$branch" && "$branch" != ${~protected_branches} &&
           "$branch" != *"$default_branch"* && "$branch" != *svn* ]] || continue
        branches+=("$branch")
        branch_tips+=("$tip")
    done <<< "$refs"

    if (( ${#branches} + ${#merged_names} == 0 )); then
        printf '%s\n' '削除候補はありません。'
        return 0
    fi

    printf '%s\n' '削除候補の worktree（対応するローカルブランチも削除）'
    for branch in "${merged_names[@]}"; do
        printf '  %s  %q\n' "$branch" "${worktree_paths[$branch]}"
    done
    printf '%s\n' '削除候補のローカルブランチ'
    for branch in "${branches[@]}"; do
        printf '  %s\n' "$branch"
    done
    local answer
    printf '%s' '表示した候補を削除しますか？ [y/N] '
    if ! IFS= read -r answer </dev/tty || [[ "$answer" != [yY] ]]; then
        printf '%s\n' '中止しました。'
        return 0
    fi

    # 確認後は候補を追加せず、先端コミットや worktree の対応が
    # 表示時から変わった項目をスキップする。
    local index resolved_worktree failed=0
    for branch in "${merged_names[@]}"; do
        worktree=${worktree_paths[$branch]}
        resolved_worktree=$(git gtr go "$branch" 2>/dev/null) || resolved_worktree=
        if [[ -z "$resolved_worktree" || "${resolved_worktree:A}" != "${worktree:A}" ||
              "$(git -C "$worktree" symbolic-ref -q HEAD)" != "refs/heads/$branch" ||
              "$(git rev-parse --verify "refs/heads/$branch")" != "${worktree_tips[$branch]}" ]]; then
            printf '候補の状態が変わったためスキップしました: %s\n' "$branch" >&2
            failed=1
            continue
        fi
        if ! changes=$(git --no-optional-locks -C "$worktree" status --porcelain --untracked-files=normal) ||
           [[ -n "$changes" ]]; then
            printf '作業ツリーを確認できないか未保存の変更があるためスキップしました: %s\n' "$branch" >&2
            failed=1
            continue
        fi
        if ! git gtr rm "$branch" --delete-branch --yes ||
           git show-ref --verify --quiet "refs/heads/$branch"; then
            failed=1
        fi
    done
    for (( index=1; index <= ${#branches}; index++ )); do
        branch=${branches[index]}
        if [[ "$(git rev-parse --verify "refs/heads/$branch")" != "${branch_tips[index]}" ]]; then
            printf '候補の状態が変わったためスキップしました: %s\n' "$branch" >&2
            failed=1
            continue
        fi
        git branch -d -- "$branch" || failed=1
    done
    return "$failed"
}

git-remove-orig-files()
{
    find . -name "*.orig" -type f | xargs rm
}

# ------------------------------
# fzf
# ------------------------------
p() {
    fzf | while read LINE; do $@ $LINE; done
}

fzf-ghq() {
    local selected_dir=$(ghq list -p | fzf --prompt "REPOSITORY > " --query "$LBUFFER")
    if [ -n "$selected_dir" ]; then
        BUFFER="cd ${selected_dir}"
        zle accept-line
    fi
    zle clear-screen
}

fzf-select-history() {
    BUFFER="$(history -nr 1 | awk '!a[$0]++' | fzf --query "$LBUFFER" | sed 's/\\n/\n/')"
    CURSOR=$#BUFFER
    zle clear-screen
}

fzf-cdr() {
    local selected_dir=$(cdr -l | awk '{ print $2 }' | fzf)
    if [ -n "$selected_dir" ]; then
        BUFFER="cd ${selected_dir}"
        zle accept-line
    fi
    zle clear-screen
}

fzf-git-branches() {
    local selected_branch=$(git branch -a | fzf --prompt "GIT BRANCH > " --query "$LBUFFER")
    if [ -n "$selected_branch" ]; then
        BUFFER="git checkout ${selected_branch}"
        zle accept-line
    fi
    zle clear-screen
}

git-gtr-pick-branch() {
    local prompt="${1:-GTR WORKTREE > }"
    local selected
    selected="$(
        git gtr list 2>/dev/null | awk '
            NF == 0 { next }
            toupper($1) == "BRANCH" { next }
            { print }
        ' | fzf --prompt "${prompt}" --query "$LBUFFER"
    )"
    if [[ -z "$selected" ]]; then
        return 1
    fi
    printf '%s\n' "$selected" | awk '{print $1}'
}

git-gtr-cd() {
    local branch="$1"
    local target_path

    if ! git gtr version >/dev/null 2>&1; then
        echo "git gtr is not installed (https://github.com/coderabbitai/git-worktree-runner)"
        return 1
    fi

    if [[ -z "$branch" ]]; then
        branch="$(git-gtr-pick-branch "GTR WORKTREE > ")" || return 1
    fi

    target_path="$(git gtr go "$branch" 2>/dev/null)" || {
        echo "failed to resolve worktree for branch: $branch"
        return 1
    }

    if [[ -z "$target_path" ]]; then
        echo "failed to resolve worktree for branch: $branch"
        return 1
    fi

    cd "$target_path" || return 1
}

fzf-git-worktrees() {
    local branch target_path

    if ! git gtr version >/dev/null 2>&1; then
        zle -M "git gtr is not installed (see github.com/coderabbitai/git-worktree-runner)"
        zle clear-screen
        return 1
    fi

    branch="$(git-gtr-pick-branch "GTR WORKTREE > ")" || {
        zle clear-screen
        return 0
    }

    target_path="$(git gtr go "$branch" 2>/dev/null)" || {
        zle -M "failed to resolve worktree for branch: $branch"
        zle clear-screen
        return 1
    }

    if [[ -n "$target_path" ]]; then
        BUFFER="cd ${(q)target_path}"
        zle accept-line
    fi
    zle clear-screen
}

check-1password-auth() {
    if command -v op >/dev/null 2>&1; then
        if op account list >/dev/null 2>&1; then
            echo "✓ 1Password CLI is authenticated"
            return 0
        else
            echo "⚠ 1Password CLI is not authenticated"
            return 1
        fi
    else
        echo "⚠ 1Password CLI is not installed"
        return 1
    fi
}
