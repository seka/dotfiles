# ------------------------------
# エディター
# ------------------------------
alias vim="nvim"

# ------------------------------
# ファイル操作
# ------------------------------
export LSCOLORS=gxfxcxdxbxegedabagacag
alias ls="ls -G"
alias grep='grep -G'
alias ll="ls -la"
alias la="ls -A"

# Finder の隠しファイル表示
alias showfiles="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias hidefiles="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"

# ------------------------------
# ネットワーク
# ------------------------------
alias speedtest="networkQuality"
alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
alias ports="lsof -i -P -n | grep LISTEN"
alias flushdns="sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder"

# ------------------------------
# シェル設定
# ------------------------------
alias dotfiles="cd ~/dotfiles"
alias reload="source ~/.zshenv && source ~/.config/zsh/.zshrc"

# ------------------------------
# Git
# ------------------------------
alias gits="git status"
alias gitc="git commit"
alias gitb="git branch"
alias gitbm="git branch -M"
alias gitzip="git archive HEAD -o "

# Worktree (gtr)
alias gtrl="git gtr list"
alias gtrn="git gtr new"
alias gtrr="git gtr rm"
alias gtrc="git gtr clean"
alias gtrcm="git gtr clean --merged"
alias gtrg="git-gtr-cd"

# ------------------------------
# tmux
# ------------------------------
# 既存の tmux セッションに接続し、切り替え先を選べるよう一覧を開く。
alias tmuxa='tmux attach-session \; choose-tree -s'
alias tmuxl="tmux list-sessions"
# 手動保存もキー操作と同じ tmux-resurrect のスクリプトを使う。
alias tmuxs='tmux run-shell "exec #{q:@resurrect-save-script-path}"'
